datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  role         String   @default("user")
  createdAt    DateTime @default(now())
}
